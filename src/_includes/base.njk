<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="site-header">
  <div class="container">
    <a href="/" class="logo">
  <img src="/images/logo.png"  height="34" style="flex:none; width:auto;">
MGC
    </a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
    <nav class="main-nav">
      <ul>
        <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/reviews.html" {% if page.url == "/reviews.html" %}aria-current="page"{% endif %}>Reviews</a></li>
	<li><a href="/articles.html" {% if page.url == "/articles.html" %}aria-current="page"{% endif %}>Articles</a></li>
	<li><a href="/news.html" {% if page.url == "/news.html" %}aria-current="page"{% endif %}>News</a></li>
        <li><a href="/about.html" {% if page.url == "/about.html" %}aria-current="page"{% endif %}>About us</a></li>
      </ul>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="site-footer">
  <div class="container">
    <p class="about">
      MGC - Stay updated with us.
    </p>
    <div class="links">
      <a href="#">Facebook</a>
      <a href="#">Youtube</a>
    </div>
  </div>
</footer>

<script src="/js/main.js"></script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function (user) {
      if (!user) {
        window.netlifyIdentity.on("login", function () {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
