---
layout: base.njk
title: "Reviews"
permalink: "/reviews.html"
---
{% set allReviews = collections.reviews | reverse %}

<section class="section" style="border-bottom:none; padding-bottom:0;">
  <div class="container">
    <h1 style="font-size:2rem; margin-bottom:24px;">LAtest reviews</h1>
    <div class="chips" role="group" aria-label="Filter by genre">
      <button class="chip" data-genre="all" aria-pressed="true">All</button>
      <button class="chip" data-genre="action">Action</button>
      <button class="chip" data-genre="rpg">RPG</button>
      <button class="chip" data-genre="souls">Soulslike</button>
      <button class="chip" data-genre="open-world">Open World</button>
      <button class="chip" data-genre="racing">Racing</button>
    </div>
  </div>
</section>

<section class="section" style="border-bottom:none;">
  <div class="container">
    <div class="grid">
      {% for review in allReviews %}
      <a class="card" href="{{ review.url }}" data-genre-tag="{{ review.data.genre_tags | join(' ') }}">
        <div class="cover {{ review.data.cover_class }}"><span class="cover-label">{{ review.data.title }}</span></div>
        <h3>{{ review.data.title }}</h3>
        <p class="meta">{{ review.data.meta }}</p>
        <p class="excerpt">{{ review.data.excerpt }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
